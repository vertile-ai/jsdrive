{
  "name": "@nodriver/api",
  "version": "0.15.5",
  "description": "Typed clean-room Chrome DevTools Protocol browser automation API",
  "private": false,
  "license": "MIT",
  "engines": { "node": ">=22" },
  "type": "module",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "smoke": "node dist/smoke.js"
  },
  "dependencies": {
    "@nodriver/protocol": "0.15.5",
    "@nodriver/runtime-js": "0.15.5"
  }
}
