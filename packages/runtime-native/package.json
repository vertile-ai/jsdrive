{
  "name": "@vertile-ai/jsdriver-runtime-native",
  "version": "0.16.0",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vertile-ai/jsdrive.git",
    "directory": "packages/runtime-native"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": { "node": ">=22" },
  "type": "module",
  "files": ["dist", "native"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build:addon": "cargo build -p nodriver-node-binding && node scripts/copy-addon.mjs",
    "build": "npm run build:addon && tsc -p tsconfig.build.json",
    "test": "npm run build:addon && tsc -p tsconfig.test.json && node --test dist-test/test/runtime-native.test.js",
    "smoke": "node dist/smoke.js"
  },
  "dependencies": {
    "@vertile-ai/jsdriver-protocol": "0.16.0",
    "@vertile-ai/jsdriver-runtime-js": "0.16.0"
  },
  "devDependencies": {
    "jsdriver": "0.16.0",
    "@types/ws": "8.18.1",
    "ws": "8.21.3"
  }
}
