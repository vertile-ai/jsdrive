{
  "name": "@nodriver/runtime-native",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": ["dist", "native"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build:addon": "cargo build -p nodriver-node-binding && node scripts/copy-addon.mjs",
    "build": "npm run build:addon && tsc -p tsconfig.build.json",
    "test": "npm run build:addon && tsc -p tsconfig.test.json && node --test dist-test/test/runtime-native.test.js",
    "smoke": "node dist/smoke.js"
  },
  "dependencies": {
    "@nodriver/protocol": "0.0.0",
    "@nodriver/runtime-js": "0.0.0"
  },
  "devDependencies": {
    "@nodriver/api": "0.0.0",
    "@types/ws": "8.18.1",
    "ws": "8.21.3"
  }
}
